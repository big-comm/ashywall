msgid ""
"This folder contains “{path}”, which is already in the library. Remove it "
"first."
msgstr ""
"Ez a mappa tartalmazza ezt: „{path}”, amely már szerepel a könyvtárban. "
"Előbb távolítsa el azt."

#: src/ashywall/ui/window_states.py:102
#, python-brace-format
msgid "“{path}” is not a folder"
msgstr "„{path}” nem mappa"

#: src/ashywall/ui/window_states.py:108
msgid "No Matching Wallpapers"
msgstr "Nincs megfelelő háttérkép"

#: src/ashywall/ui/window_states.py:109 src/ashywall/ui/window_states.py:172
msgid "Try other search terms or filters."
msgstr "Próbáljon más keresési kifejezéseket vagy szűrőket."

#: src/ashywall/ui/window_states.py:120
msgid "No System Wallpapers Found"
msgstr "Nem találhatók rendszerháttérképek"

#: src/ashywall/ui/window_states.py:122
msgid ""
"AshyWall looked in the GNOME background catalogs and in the shared "
"backgrounds and wallpapers folders."
msgstr ""
"Az AshyWall a GNOME háttérkép-katalógusaiban, valamint a megosztott "
"backgrounds és wallpapers mappákban keresett."

#: src/ashywall/ui/window_states.py:128
msgid "No Images in Your Folders"
msgstr "Nincsenek képek a mappáiban"

#: src/ashywall/ui/window_states.py:128
msgid "No Folders Added"
msgstr "Nincs hozzáadott mappa"

#: src/ashywall/ui/window_states.py:130
msgid ""
"Add folders with images. AshyWall only reads them; nothing is moved or "
"deleted."
msgstr ""
"Adjon hozzá képeket tartalmazó mappákat. Az AshyWall csak olvassa őket; "
"semmit sem helyez át vagy töröl."

#: src/ashywall/ui/window_states.py:137
msgid "No Downloads Yet"
msgstr "Még nincsenek letöltések"

#: src/ashywall/ui/window_states.py:138
msgid "Wallpapers you download from online sources appear here."
msgstr "Az online forrásokból letöltött háttérképek itt jelennek meg."

#: src/ashywall/ui/window_states.py:143
msgid "This Collection Is Empty"
msgstr "Ez a gyűjtemény üres"

#: src/ashywall/ui/window_states.py:144
msgid "Use the bookmark button on a wallpaper's page to add it here."
msgstr "Egy háttérképet az oldalán lévő könyvjelző gombbal adhat hozzá ide."

#: src/ashywall/ui/window_states.py:149
msgid "No Favorites Yet"
msgstr "Még nincsenek kedvencek"

#: src/ashywall/ui/window_states.py:150
msgid "Use the star on a wallpaper's page to keep it here."
msgstr "Egy háttérképet az oldalán lévő csillaggal tarthat meg itt."

#: src/ashywall/ui/window_states.py:154
msgid "No Wallpapers Yet"
msgstr "Még nincsenek háttérképek"

#: src/ashywall/ui/window_states.py:155
msgid "Add a folder with images to start your library."
msgstr "A könyvtár elindításához adjon hozzá egy képeket tartalmazó mappát."

#: src/ashywall/ui/window_states.py:166 src/ashywall/ui/window_states.py:178
#, python-brace-format
msgid "No Results on {provider}"
msgstr "Nincs találat itt: {provider}"

#: src/ashywall/ui/window_states.py:168
msgid ""
"“Top this month” only includes wallpapers ranked in the last month. Sort by "
"relevance or most favorited to search all of Wallhaven."
msgstr ""
"A „Legjobbak ebben a hónapban” csak az elmúlt hónapban rangsorolt "
"háttérképeket tartalmazza. A teljes Wallhaven kereséséhez rendezzen "
"relevancia vagy a kedvencek száma szerint."

#: src/ashywall/ui/window_states.py:179
msgid "Try again later."
msgstr "Próbálja újra később."

#: src/ashywall/ui/window_states.py:185
#, python-brace-format
msgid "{provider} Is Unreachable"
msgstr "{provider} nem érhető el"

#: src/ashywall/ui/window_states.py:187
msgid "Too Many Requests"
msgstr "Túl sok kérés"

#: src/ashywall/ui/window_states.py:193
#, python-brace-format
msgid "{provider} Is Currently Unavailable"
msgstr "{provider} jelenleg nem érhető el"

#: src/ashywall/ui/window_states.py:195
#, python-brace-format
msgid "{provider} Could Not Be Loaded"
msgstr "Nem sikerült betölteni: {provider}"

#: src/ashywall/ui/window_states.py:216
#, python-brace-format
msgid "{count} result on {provider}"
msgid_plural "{count} results on {provider}"
msgstr[0] "{provider}: {count} találat"
msgstr[1] "{provider}: {count} találat"

#: src/ashywall/ui/window_states.py:219
#, python-brace-format
msgid "{count} shown · page {page} of {last}"
msgstr "{count} látható · oldal: {page}/{last}"
