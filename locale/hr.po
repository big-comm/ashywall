msgid "No Results on {provider}"
msgstr "Nema rezultata na izvoru {provider}"

#: src/ashywall/ui/window_states.py:168
msgid ""
"“Top this month” only includes wallpapers ranked in the last month. Sort by "
"relevance or most favorited to search all of Wallhaven."
msgstr ""
"“Najbolje ovog mjeseca” uključuje samo pozadine rangirane u posljednjih "
"mjesec dana. Razvrstajte po relevantnosti ili po broju favorita kako biste "
"pretražili cijeli Wallhaven."

#: src/ashywall/ui/window_states.py:179
msgid "Try again later."
msgstr "Pokušajte ponovno kasnije."

