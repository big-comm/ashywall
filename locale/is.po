msgstr ""
"Þjónustan er ekki tiltæk í augnablikinu (HTTP {status}). Reyndu aftur síðar."

#: src/ashywall/ui/errors.py:29
#, python-brace-format
msgid "The server answered with an error ({status})."
msgstr "Þjónninn svaraði með villu ({status})."

